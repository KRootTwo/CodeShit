   "source": [
    "S = [1, 2, 3]\n",
    "R = [(1, 2), (1, 1), (2, 2), (3, 3), (2, 1)]\n",
    "\n",
    "refl = all((i, i) in R for i in S)\n",
    "symm = all((i, j) in R for (j, i) in R)\n",
    "tran = all((a, c) in R for (a, b1) in R for (b2, c) in R if b1 == b2)\n",
    "\n",
    "print(f\"{refl}\")\n",
    "print(f\"{symm}\")\n",
    "print(f\"{tran}\")"
   ]
  }
